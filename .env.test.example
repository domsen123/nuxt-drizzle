# Umgebung für die Testsuite. Kopiere die Datei nach `.env.test`.
#
# `pnpm docker:test:up` startet daraus den Postgres-Container, `pnpm test:db:push`
# pusht das Schema und `pnpm test:run` fährt die Tests dagegen.
#
# Wähle Port und Datenbankname abweichend von `.env`. Die Testsuite leert nach
# jedem Test die Tabellen — zeigt sie auf die Entwicklungsdatenbank, sind deren
# Daten weg.
NUXT_SITE_NAME="Cockpit Test"
NUXT_SITE_ENV="development"
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

NUXT_DATABASE_HOST="localhost"
NUXT_DATABASE_PORT="5460"
NUXT_DATABASE_USER="postgres"
NUXT_DATABASE_PASSWORD="postgres"
NUXT_DATABASE_NAME="nuxt-drizzl-test"

NUXT_AUTH_SECRET="test-secret-not-for-production"

NUXT_EMAIL_PROVIDER="console"
NUXT_STORAGE_PROVIDER="local"
