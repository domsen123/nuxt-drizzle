{
  "name": "nuxt-ui-template-saas",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:clean": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml build && docker compose -f docker-compose.dev.yml up -d",
    "docker:test:up": "docker compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker compose -f docker-compose.test.yml down -v",
    "db:push": "drizzle-kit push",
    "test:db:push": "dotenv -e .env.test -- drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.87",
    "@iconify-json/simple-icons": "^1.2.68",
    "@nuxt/content": "^3.11.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/seo": "^3.3.0",
    "@pinia/colada": "^0.21.2",
    "@pinia/colada-nuxt": "^0.3.1",
    "@pinia/nuxt": "^0.11.3",
    "@standard-schema/spec": "^1.1.0",
    "@vueuse/nuxt": "^14.1.0",
    "@vueuse/router": "^14.1.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "hookable": "^6.0.1",
    "liquidjs": "^10.24.0",
    "mitt": "^3.0.1",
    "nodemailer": "^7.0.13",
    "nuxt": "^4.3.0",
    "nuxt-og-image": "^5.1.13",
    "pinia": "^3.0.4",
    "postgres": "^3.4.8",
    "ulid": "^3.0.2",
    "undici": "^7.19.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@faker-js/faker": "^10.2.0",
    "@nuxt/test-utils": "^3.23.0",
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^7.0.9",
    "@vue/test-utils": "^2.4.6",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "happy-dom": "^20.3.9",
    "nuxt-mcp-dev": "^0.3.2",
    "playwright-core": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
